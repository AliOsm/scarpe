----------- app code
Shoes.app { para "Reads the clipboard from its test code" }
----------- test code
# Seed the renderer's private clipboard on native, or the shell stubs' sandbox file.
board = ENV.fetch("SPEC_CLIPBOARD_FILE")
if ENV["SCARPE_DISPLAY_SERVICE"] == "native"
  Shoes::DisplayService.display_service.clipboard = "copied in another program"
else
  File.write(board, "copied in another program")
end

assert_equal "copied in another program", Shoes.APPS.first.clipboard, "clipboard reads the system-wide clipboard"
